NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# Host port bindings for infra/docker-compose.yml. Change these if 5432/6379 are
# already taken on the host; keep DATABASE_URL and REDIS_URL in sync.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
OBJECT_STORE_HOST_PORT=9000
OBJECT_STORE_CONSOLE_HOST_PORT=9001

DATABASE_URL=postgresql://smart_home:smart_home@localhost:5432/smart_home?schema=public&connection_limit=10
DIRECT_URL=postgresql://smart_home:smart_home@localhost:5432/smart_home?schema=public

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000

JWT_ACCESS_SECRET=development-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=development-refresh-secret-change-me-32-chars
JWT_ISSUER=smart-home-api
JWT_AUDIENCE=smart-home-clients
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=development-csrf-secret-change-me-32-chars

OTP_PEPPER=development-otp-pepper-change-me-32-chars
TOTP_ENCRYPTION_KEY=Jv5W3JV09kkaHVhT8+vYV6wGykvZdCHHjcQ4Ml64utM=

PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=mock
STORAGE_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=development-webhook-secret

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
STORAGE_BUCKETS=evidence,documents,recordings,reports

SMTP_URL=smtp://localhost:1025
MAILPIT_UI=http://localhost:8025

DEV_INBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

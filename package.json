{
  "name": "smart-home-maintenance-service",
  "version": "0.0.0",
  "private": true,
  "description": "Smart Home Maintenance Services — backend foundation (npm workspaces + Turborepo + NestJS 11 / Fastify)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/config",
    "packages/contracts",
    "packages/domain",
    "packages/db",
    "apps/api"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "npm run test:integration --workspace @smart-home/api",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "db:migrate": "npm run db:migrate --workspace @smart-home/db",
    "db:new": "npm run db:new --workspace @smart-home/db",
    "db:status": "npm run db:status --workspace @smart-home/db",
    "db:pull": "npm run db:pull --workspace @smart-home/db",
    "db:reset": "npm run db:reset --workspace @smart-home/db",
    "db:seed": "npm run db:seed --workspace @smart-home/db",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.4",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}

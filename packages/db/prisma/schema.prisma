generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model account_balances {
  account_id      String          @id @db.Uuid
  debit_total     BigInt          @default(0)
  credit_total    BigInt          @default(0)
  balance         BigInt?         @default(dbgenerated("(credit_total - debit_total)"))
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  ledger_accounts ledger_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model addresses {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   String                   @db.Uuid
  label         String
  line1         String
  line2         String?
  area_id       Int
  location      Unsupported("geography")
  notes         String?
  is_default    Boolean                  @default(false)
  archived_at   DateTime?                @db.Timestamptz(6)
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  areas         areas                    @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers     customers                @relation(fields: [customer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  bookings      bookings[]
  subscriptions subscriptions[]

  @@index([location], map: "addresses_location_gix", type: Gist)
}

model appeals {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  penalty_id    String        @unique @db.Uuid
  provider_id   String        @db.Uuid
  grounds       String
  status        appeal_status @default(OPEN)
  decided_by    String?       @db.Uuid
  decision_note String?
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  decided_at    DateTime?     @db.Timestamptz(6)
  users         users?        @relation(fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  penalties     penalties     @relation(fields: [penalty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providers     providers     @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model areas {
  id                     Int                       @id @default(autoincrement())
  city_id                Int
  name                   String
  centroid               Unsupported("geography")?
  boundary               Unsupported("geography")?
  is_active              Boolean                   @default(true)
  addresses              addresses[]
  cities                 cities                    @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider_service_areas provider_service_areas[]

  @@unique([city_id, name])
  @@index([city_id], map: "areas_city_idx")
}

model audit_log {
  id            BigInt     @id @default(autoincrement())
  actor_user_id String?    @db.Uuid
  actor_role    actor_role
  action        String
  entity_type   String
  entity_id     String
  before        Json?
  after         Json?
  ip            String?    @db.Inet
  user_agent    String?
  request_id    String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  users         users?     @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_user_id, created_at], map: "audit_log_actor_idx")
  @@index([entity_type, entity_id, created_at], map: "audit_log_entity_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_items {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id       String           @db.Uuid
  revision_id      String?          @db.Uuid
  kind             item_kind
  description      String
  quantity         Decimal          @default(1) @db.Decimal(10, 2)
  unit_price_paisa BigInt
  amount_paisa     BigInt
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  bookings         bookings         @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quote_revisions  quote_revisions? @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([booking_id], map: "booking_items_booking_idx")
}

model booking_offers {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id   String       @db.Uuid
  provider_id  String       @db.Uuid
  rank         Int          @db.SmallInt
  status       offer_status @default(PENDING)
  offered_at   DateTime     @default(now()) @db.Timestamptz(6)
  expires_at   DateTime     @db.Timestamptz(6)
  responded_at DateTime?    @db.Timestamptz(6)
  bookings     bookings     @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providers    providers    @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, provider_id])
  @@index([provider_id, status], map: "booking_offers_provider_idx")
}

model booking_status_history {
  id            BigInt          @id @default(autoincrement())
  booking_id    String          @db.Uuid
  from_status   booking_status?
  to_status     booking_status
  event         String
  actor_user_id String?         @db.Uuid
  actor_role    actor_role
  reason        String?
  metadata      Json            @default("{}")
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  users         users?          @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings      bookings        @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([booking_id, id], map: "booking_status_history_booking_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model bookings {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                   @unique @default(dbgenerated("('SHM-'::text || lpad((nextval('booking_code_seq'::regclass))::text, 7, '0'::text))"))
  customer_id            String                   @db.Uuid
  provider_id            String?                  @db.Uuid
  service_id             Int
  address_id             String                   @db.Uuid
  subscription_id        String?                  @db.Uuid
  status                 booking_status
  payment_mode           payment_mode
  payment_status         booking_payment_status   @default(NONE)
  is_emergency           Boolean                  @default(false)
  is_auto_assign         Boolean                  @default(false)
  slot                   Unsupported("tstzrange")
  scheduled_start        DateTime                 @db.Timestamptz(6)
  scheduled_end          DateTime                 @db.Timestamptz(6)
  problem_text           String?
  quoted_amount_paisa    BigInt
  approved_total_paisa   BigInt
  final_amount_paisa     BigInt?
  discount_paisa         BigInt                   @default(0)
  commission_rate_bp     Int
  coupon_id              String?                  @db.Uuid
  start_otp_hash         String?
  start_otp_attempts     Int                      @default(0) @db.SmallInt
  start_otp_locked_until DateTime?                @db.Timestamptz(6)
  start_otp_verified_at  DateTime?                @db.Timestamptz(6)
  checkin_at             DateTime?                @db.Timestamptz(6)
  checkin_distance_m     Int?
  checkin_accuracy_m     Int?
  checkout_at            DateTime?                @db.Timestamptz(6)
  checkout_distance_m    Int?
  completed_at           DateTime?                @db.Timestamptz(6)
  verification_tier      verification_tier?
  visit_no               Int                      @default(1) @db.SmallInt
  failed_rework_count    Int                      @default(0) @db.SmallInt
  reschedule_count       Int                      @default(0) @db.SmallInt
  no_show_party          no_show_party?
  cancel_reason          String?
  released_at            DateTime?                @db.Timestamptz(6)
  warranty_until         DateTime?                @db.Timestamptz(6)
  closed_at              DateTime?                @db.Timestamptz(6)
  version                Int                      @default(1)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  booking_items          booking_items[]
  booking_offers         booking_offers[]
  booking_status_history booking_status_history[]
  addresses              addresses                @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupons                coupons?                 @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers              customers                @relation(fields: [customer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  providers              providers?               @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  services               services                 @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions          subscriptions?           @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaints             complaints[]
  coupon_redemptions     coupon_redemptions?
  disputes               disputes[]
  invoices               invoices?
  job_checklist_results  job_checklist_results[]
  job_evidence           job_evidence[]
  ledger_accounts        ledger_accounts[]
  ledger_transactions    ledger_transactions[]
  messages               messages[]
  payments               payments[]
  penalties              penalties[]
  plan_visits            plan_visits?
  provider_flags         provider_flags[]
  quote_revisions        quote_revisions[]
  ratings                ratings[]
  refunds                refunds[]
  verification_calls     verification_calls[]

  @@index([created_at], map: "bookings_created_idx")
  @@index([customer_id, created_at(sort: Desc)], map: "bookings_customer_idx")
  @@index([provider_id, scheduled_start], map: "bookings_provider_idx")
  @@index([service_id], map: "bookings_service_idx")
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model breach_types {
  code                 String          @id
  name_en              String
  name_ur              String
  category             breach_category
  points               Int             @db.SmallInt
  fine_rule            Json            @default("{}")
  schedule_consequence String?
  is_active            Boolean         @default(true)
  penalties            penalties[]
}

model categories {
  id                    Int                @id @default(autoincrement())
  slug                  String             @unique
  name_en               String
  name_ur               String
  sort_order            Int                @default(0)
  default_warranty_days Int                @default(0)
  is_active             Boolean            @default(true)
  commission_rules      commission_rules[]
  services              services[]
}

model cities {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  timezone  String      @default("Asia/Karachi")
  is_active Boolean     @default(true)
  areas     areas[]
  providers providers[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commission_rules {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          commission_scope
  category_id    Int?
  provider_id    String?          @db.Uuid
  rate_bp        Int
  effective_from DateTime         @default(now()) @db.Timestamptz(6)
  effective_to   DateTime?        @db.Timestamptz(6)
  created_by     String?          @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  categories     categories?      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providers      providers?       @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model complaint_events {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaint_id  String               @db.Uuid
  actor_user_id String?              @db.Uuid
  type          complaint_event_type
  from_status   complaint_status?
  to_status     complaint_status?
  body          String?
  evidence_key  String?
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  users         users?               @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaints    complaints           @relation(fields: [complaint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model complaints {
  id                                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id                                String?               @db.Uuid
  raised_by_user_id                         String?               @db.Uuid
  against_user_id                           String                @db.Uuid
  source                                    complaint_source
  category                                  complaint_category
  severity                                  complaint_severity
  status                                    complaint_status      @default(OPEN)
  description                               String
  sla_due_at                                DateTime              @db.Timestamptz(6)
  assigned_to                               String?               @db.Uuid
  resolution                                complaint_resolution?
  resolution_note                           String?
  created_at                                DateTime              @default(now()) @db.Timestamptz(6)
  resolved_at                               DateTime?             @db.Timestamptz(6)
  complaint_events                          complaint_events[]
  users_complaints_against_user_idTousers   users                 @relation("complaints_against_user_idTousers", fields: [against_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_complaints_assigned_toTousers       users?                @relation("complaints_assigned_toTousers", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings                                  bookings?             @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_complaints_raised_by_user_idTousers users?                @relation("complaints_raised_by_user_idTousers", fields: [raised_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  disputes                                  disputes[]
  penalties                                 penalties[]

  @@index([against_user_id], map: "complaints_against_idx")
  @@index([status, severity, sla_due_at], map: "complaints_queue_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupon_redemptions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupon_id      String    @db.Uuid
  customer_id    String    @db.Uuid
  booking_id     String    @unique @db.Uuid
  discount_paisa BigInt
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupons        coupons   @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers @relation(fields: [customer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique @db.Citext
  kind               coupon_kind
  value              Int
  max_discount_paisa BigInt?
  valid_from         DateTime             @db.Timestamptz(6)
  valid_to           DateTime             @db.Timestamptz(6)
  usage_limit        Int?
  per_customer_limit Int                  @default(1)
  is_referral        Boolean              @default(false)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  bookings           bookings[]
  coupon_redemptions coupon_redemptions[]
}

model customers {
  user_id            String               @id @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  addresses          addresses[]
  bookings           bookings[]
  coupon_redemptions coupon_redemptions[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favourites         favourites[]
  ratings            ratings[]
  subscriptions      subscriptions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model demerit_awards {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id      String    @db.Uuid
  penalty_id       String    @unique @db.Uuid
  points_awarded   Int       @db.SmallInt
  points_remaining Int       @db.SmallInt
  awarded_at       DateTime  @default(now()) @db.Timestamptz(6)
  expires_at       DateTime  @db.Timestamptz(6)
  last_decay_at    DateTime? @db.Timestamptz(6)
  voided_at        DateTime? @db.Timestamptz(6)
  penalties        penalties @relation(fields: [penalty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providers        providers @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disputes {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id          String              @db.Uuid
  complaint_id        String?             @db.Uuid
  origin              dispute_origin
  status              dispute_status      @default(OPEN)
  reply_due_at        DateTime?           @db.Timestamptz(6)
  provider_reply      String?
  provider_replied_at DateTime?           @db.Timestamptz(6)
  resolution          dispute_resolution?
  release_paisa       BigInt?
  refund_paisa        BigInt?
  resolved_by         String?             @db.Uuid
  resolved_at         DateTime?           @db.Timestamptz(6)
  note                String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  bookings            bookings            @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaints          complaints?         @relation(fields: [complaint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?              @relation(fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  penalties           penalties[]
}

model favourites {
  customer_id String    @db.Uuid
  provider_id String    @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  providers   providers @relation(fields: [provider_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([customer_id, provider_id])
}

model idempotency_keys {
  key          String
  user_id      String   @db.Uuid
  route        String
  request_hash String
  status_code  Int?
  response     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([key, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String   @unique @db.Uuid
  number          String   @unique @default(dbgenerated("((('INV-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('invoice_number_seq'::regclass))::text, 6, '0'::text))"))
  subtotal_paisa  BigInt
  surcharge_paisa BigInt   @default(0)
  discount_paisa  BigInt   @default(0)
  total_paisa     BigInt
  pdf_key         String?
  issued_at       DateTime @default(now()) @db.Timestamptz(6)
  bookings        bookings @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model job_checklist_results {
  booking_id              String                  @db.Uuid
  checklist_item_id       Int
  visit_no                Int                     @default(1) @db.SmallInt
  done                    Boolean
  evidence_id             String?                 @db.Uuid
  completed_at            DateTime                @default(now()) @db.Timestamptz(6)
  bookings                bookings                @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service_checklist_items service_checklist_items @relation(fields: [checklist_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job_evidence            job_evidence?           @relation(fields: [evidence_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([booking_id, checklist_item_id, visit_no])
}

model job_evidence {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id              String                    @db.Uuid
  kind                    evidence_kind
  visit_no                Int                       @default(1) @db.SmallInt
  checklist_item_id       Int?
  storage_key             String
  content_type            String
  size_bytes              Int
  client_uuid             String                    @db.Uuid
  client_captured_at      DateTime?                 @db.Timestamptz(6)
  received_at             DateTime                  @default(now()) @db.Timestamptz(6)
  location                Unsupported("geography")?
  uploaded_by             String                    @db.Uuid
  job_checklist_results   job_checklist_results[]
  bookings                bookings                  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service_checklist_items service_checklist_items?  @relation(fields: [checklist_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users                     @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, client_uuid])
  @@index([booking_id, kind], map: "job_evidence_booking_idx")
}

model ledger_accounts {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             account_type
  owner_user_id    String?           @db.Uuid
  booking_id       String?           @db.Uuid
  subscription_id  String?           @db.Uuid
  currency         String            @default("PKR") @db.Char(3)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  account_balances account_balances?
  bookings         bookings?         @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users?            @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions    subscriptions?    @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger_entries   ledger_entries[]

  @@unique([type, owner_user_id, booking_id, subscription_id], map: "ledger_accounts_uniq")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ledger_entries {
  id                  BigInt              @id @default(autoincrement())
  transaction_id      String              @db.Uuid
  account_id          String              @db.Uuid
  direction           entry_direction
  amount_paisa        BigInt
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  ledger_accounts     ledger_accounts     @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger_transactions ledger_transactions @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, id], map: "ledger_entries_account_idx")
  @@index([transaction_id], map: "ledger_entries_tx_idx")
}

model ledger_transactions {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                      ledger_tx_type
  booking_id                String?               @db.Uuid
  idempotency_key           String                @unique
  reverses_transaction_id   String?               @db.Uuid
  memo                      String?
  created_by                String?               @db.Uuid
  created_at                DateTime              @default(now()) @db.Timestamptz(6)

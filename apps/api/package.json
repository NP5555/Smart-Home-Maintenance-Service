{
  "name": "@smart-home/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:worker": "dotenv -e ../../.env -- node dist/worker.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-fastify": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.12.0",
    "@smart-home/config": "*",
    "@smart-home/contracts": "*",
    "@smart-home/db": "*",
    "@smart-home/domain": "*",
    "bullmq": "^5.56.4",
    "dotenv-cli": "^8.0.0",
    "fastify": "5.11.3",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@smart-home/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:worker": "dotenv -e ../../.env -- node dist/worker.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "api:surface": "dotenv -e ../../.env -- tsx scripts/api-surface.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.12.0",
    "@smart-home/config": "*",
    "@smart-home/contracts": "*",
    "@smart-home/db": "*",
    "@smart-home/domain": "*",
    "argon2": "^0.43.1",
    "bullmq": "^5.56.4",
    "dotenv-cli": "^8.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.4",
    "light-my-request": "^6.6.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
